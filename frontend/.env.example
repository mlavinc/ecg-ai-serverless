# Backend API base URL for the Vite/React app.
#
# Use the Lambda Function URL when hosting the frontend on Vercel (or any
# host other than the CloudFront distribution that already proxies /api/*).
#
# Example:
#   VITE_API_URL=https://your-id.lambda-url.sa-east-1.on.aws
#
# Leave unset for same-origin CloudFront deploys (defaults to relative /api).
VITE_API_URL=
