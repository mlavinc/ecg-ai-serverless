# Copy to terraform.tfvars (gitignored) and adjust for your account.
# All values also have defaults in variables.tf — this file is optional.

aws_region   = "sa-east-1"
project_name = "ecg-ai"

# Existing bucket that holds the trained model (NOT managed by this Terraform).
model_bucket_name = "ecg-ai-models-mlavinc"
model_key         = "random_forest_final.joblib"

# Path to the Lambda ZIP relative to the infra/ directory.
# Terraform uploads it to the artifacts bucket (S3) — required because the
# ZIP exceeds the ~50 MB direct CreateFunction upload limit.
lambda_zip_path         = "../lambda.zip"
lambda_s3_key           = "lambda/lambda.zip"
artifacts_bucket_suffix = ""

lambda_memory_size = 1024
lambda_timeout     = 30

log_retention_days = 14
